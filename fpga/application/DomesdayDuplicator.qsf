# GPIO0[33] is the ADC's sampling clock, generated by the divide-by-two
# register in the top level. Placing that register in the pin's own I/O cell
# makes the clock edge register-determined rather than routing-determined,
# which is what the ADC's sampling instant depends on. The fitter duplicates
# the register to keep driving sample_enable in the fabric; that is expected,
# and the fitter report is where to confirm it.
set_instance_assignment -name FAST_OUTPUT_REGISTER ON -to GPIO0[33]
#set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to GPIO0_IN[0]
#set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to GPIO0_IN[1]
