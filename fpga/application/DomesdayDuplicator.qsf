set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to DRAM_DQM[0]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to DRAM_DQM[1]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to DRAM_RAS_N
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to DRAM_WE_N
set_instance_assignment -name FAST_OUTPUT_REGISTER ON -to DRAM_ADDR[*]
set_instance_assignment -name FAST_OUTPUT_REGISTER ON -to DRAM_BA[*]
set_instance_assignment -name FAST_OUTPUT_REGISTER ON -to DRAM_CAS_N
set_instance_assignment -name FAST_OUTPUT_REGISTER ON -to DRAM_CKE
set_instance_assignment -name FAST_OUTPUT_REGISTER ON -to DRAM_CS_N
set_instance_assignment -name FAST_OUTPUT_REGISTER ON -to DRAM_DQM[*]
set_instance_assignment -name FAST_OUTPUT_REGISTER ON -to DRAM_RAS_N
set_instance_assignment -name FAST_OUTPUT_REGISTER ON -to DRAM_WE_N
set_instance_assignment -name FAST_OUTPUT_REGISTER ON -to DRAM_DQ[*]
set_instance_assignment -name FAST_OUTPUT_ENABLE_REGISTER ON -to DRAM_DQ[*]
set_instance_assignment -name FAST_INPUT_REGISTER ON -to DRAM_DQ[*]


#============================================================
# Reproducibility
#============================================================
# The Fitter is deterministic for a given seed, so a rebuild of the same commit
# on the same Quartus version reproduces the same placement and routing. Both
# settings below are Quartus' own defaults; they are written out explicitly so
# the guarantee rests on this file rather than on a default that a future
# version could change.
#
# Measured, not assumed — see fpga/README.md "Reproducibility":
# rebuilding this project twice produces a byte-identical .jic, and a .sof
# differing only in a compile timestamp, a per-run design hash and the file
# checksum that covers them.
set_global_assignment -name SEED 1
set_global_assignment -name NUM_PARALLEL_PROCESSORS 4

set_global_assignment -name MIN_CORE_JUNCTION_TEMP 0
set_global_assignment -name MAX_CORE_JUNCTION_TEMP 85
set_global_assignment -name POWER_PRESET_COOLING_SOLUTION "23 MM HEAT SINK WITH 200 LFPM AIRFLOW"
set_global_assignment -name POWER_BOARD_THERMAL_MODEL "NONE (CONSERVATIVE)"
set_global_assignment -name PARTITION_NETLIST_TYPE SOURCE -section_id Top
set_global_assignment -name PARTITION_FITTER_PRESERVATION_LEVEL PLACEMENT_AND_ROUTING -section_id Top
set_global_assignment -name PARTITION_COLOR 16764057 -section_id Top


#============================================================
# Remote update
#============================================================
# Both images are compiled with remote update enabled, which is what makes the
# device's reconfiguration block reachable from the fabric. This image uses it
# for two things: tickling the watchdog the factory image armed before it
# handed over, and triggering the reconfiguration that follows a gateware
# update.
#
# The assignment carries a Stratix III name on a Cyclone IV part. That is
# Quartus', not a mistake here: the same setting covers both families and
# Quartus writes it out under this name whichever device is selected.
set_global_assignment -name STRATIXIII_UPDATE_MODE "REMOTE"

#============================================================
# The active serial pins
#============================================================
# DCLK, nCSO, ASDO and DATA0 are the configuration circuitry's own pins,
# reached from the fabric through asmiBlock. They are not in the pin
# assignments above because they are not user I/O and their locations are
# fixed by the device - but their I/O standard is not, and it defaults to
# 2.5 V, which is a fitter error against a bank whose VCCIO is 3.3 V because
# every other pin in it is 3.3-V LVTTL. The EPCS64 on the DE0-Nano is a
# 3.3 V part on that same bank.
# The device-wide default I/O standard does it, rather than four assignments
# by pin name: these pins do not have names in this project - Quartus derives
# them from the asmiBlock instance - and every pin that does is assigned
# 3.3-V LVTTL individually above, so the default reaches nothing else.
set_global_assignment -name STRATIX_DEVICE_IO_STANDARD "3.3-V LVTTL"

#============================================================
# nCEO
#============================================================
# PIN_F16 is the device's nCEO, a dual-purpose configuration pin, and the
# DE0-Nano also routes it to JP3 as GPIO_2[9]. nCEO only passes configuration
# on to the nCE of a next device in a chain, and the DE0-Nano's chain is this
# one device, so nothing depends on it. The Cyclone IV default keeps it as a
# programming pin after configuration, which puts two pins at F16 and fails
# the fit. Released to regular I/O, it is GPIO_2[9], high-Z like the other
# unused JP3 pins. While the device is configuring it is nCEO either way.
# The factory image declares no JP3 pins and keeps the default.
set_global_assignment -name CYCLONEII_RESERVE_NCEO_AFTER_CONFIGURATION "USE AS REGULAR IO"

# The gateware shared with the factory image lives in fpga/common and is named
# here by relative path, so there is one copy of the register bank and the
# flash bridge rather than two that could drift. version.vh is reached through
# SEARCH_PATH because the top level includes it by name.
set_global_assignment -name SEARCH_PATH ../common

set_global_assignment -name VERILOG_FILE DomesdayDuplicator.v
set_global_assignment -name SDC_FILE DomesdayDuplicator.SDC
set_global_assignment -name VERILOG_FILE applicationPll.v
set_global_assignment -name MISC_FILE applicationPll_bb.v
set_global_assignment -name VERILOG_FILE dataGenerator.v
set_global_assignment -name VERILOG_FILE halfBandDecimator.v
set_global_assignment -name VERILOG_FILE fx3StateMachine.v
set_global_assignment -name VERILOG_FILE buffer.v
set_global_assignment -name VERILOG_FILE bufferMonitor.v
set_global_assignment -name VERILOG_FILE fifo.v
set_global_assignment -name VERILOG_FILE adc128spiController.v
set_global_assignment -name VERILOG_FILE pcm1802Slave.v
set_global_assignment -name VERILOG_FILE asyncFifo.v
set_global_assignment -name VERILOG_FILE sdramController.v
set_global_assignment -name VERILOG_FILE sdramBuffer.v
set_global_assignment -name CDF_FILE DomesdayDuplicator_write_sof.cdf
set_global_assignment -name VERILOG_FILE ../common/spiRegisters.v
set_global_assignment -name VERILOG_FILE ../common/flashBridge.v
set_global_assignment -name VERILOG_FILE ../common/asmiBlock.v
set_global_assignment -name VERILOG_FILE ../common/remoteUpdate.v
set_instance_assignment -name PARTITION_HIERARCHY root_partition -to | -section_id Top